<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilosjavafx.controllers.ProcesadorController"
      alignment="CENTER"
      spacing="20"
      prefWidth="550"
      prefHeight="450">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Monitor de Procesamiento - NicaData Solutions"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- SECCIÓN CLIENTES -->
    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Proceso de Clientes (100 registros)" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ProgressBar fx:id="barraClientes" progress="0" prefWidth="320"/>
            <Label fx:id="lblPorcentajeClientes" text="0%"/>
        </HBox>
        <Label fx:id="lblEstadoClientes" text="Esperando inicio"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnIniciarClientes" text="Iniciar Clientes" onAction="#iniciarClientes"/>
            <Button fx:id="btnDetenerClientes" text="Detener Clientes" onAction="#detenerClientes" disable="true"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- SECCIÓN PRODUCTOS -->
    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Proceso de Productos (50 registros)" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ProgressBar fx:id="barraProductos" progress="0" prefWidth="320"/>
            <Label fx:id="lblPorcentajeProductos" text="0%"/>
        </HBox>
        <Label fx:id="lblEstadoProductos" text="Esperando inicio"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnIniciarProductos" text="Iniciar Productos" onAction="#iniciarProductos"/>
            <Button fx:id="btnDetenerProductos" text="Detener Productos" onAction="#detenerProductos" disable="true"/>
        </HBox>
    </VBox>

</VBox>